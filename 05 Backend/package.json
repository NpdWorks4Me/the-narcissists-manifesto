{
  "name": "the-narcissists-manifesto",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Autonomous Obsidian Vault Architect & Content Intelligence Agent — backend",
  "scripts": {
    "vault:setup": "tsx src/vault/provision.ts",
    "vault:check": "tsx src/vault/health.ts",
    "vault:health": "tsx src/vault/health.ts",
    "vault:freshness": "tsx src/vault/health.ts --freshness",
    "vault:engine-a": "tsx src/vault/vault-engine-a.ts",
    "vault:engine-b": "tsx src/vault/vault-engine-b.ts",
    "vault:daemon": "tsx src/vault/vaultd.ts",
    "vault:nightly": "tsx src/vault/vaultd.ts --nightly --apply",
    "vault:report": "tsx src/vault/report.ts",
    "vault:setup-plugins": "tsx scripts/setup-plugins.ts",
    "vault:reindex": "tsx src/vault/reindex.ts --apply",
    "vault:eval": "tsx src/vault/eval.ts",
    "vault:reconcile": "tsx src/vault/reconcile.ts --apply",
    "vault:synthesize": "tsx src/vault/synthesize.ts --apply",
    "vault:heal": "tsx src/vault/heal.ts --apply",
    "vault:challenge": "tsx src/vault/challenge.ts",
    "vault:emerge": "tsx src/vault/emerge.ts",
    "vault:recall": "tsx src/vault/recall.ts",
    "vault:ingest": "tsx src/vault/ingest.ts",
    "research": "tsx src/research/cli.ts",
    "research:deep": "tsx src/research/researchDeep.ts",
    "research:watch": "tsx src/research/watch.ts",
    "research:25min": "tsx src/research/orchestrator.ts",
    "research:10min": "tsx src/research/orchestrator.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "chokidar": "^4.0.1",
    "compromise": "^14.14.4",
    "date-fns": "^4.1.0",
    "dotenv": "^17.4.2",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
